# Copier ce fichier en .env.local et remplir les valeurs. .env.local n'est jamais commité.

# Fournisseur de prix : "mock" (données fictives réalistes, par défaut) ou "travelpayouts" (prix réels, en cache 48 h).
PRICE_PROVIDER=mock

# Travelpayouts / Aviasales Data API — compte gratuit sur https://www.travelpayouts.com (voir docs/APIS.md).
# Token : Profil → API token. Marker : identifiant partenaire, ajouté aux liens de réservation Aviasales.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Optionnel : SerpApi (Google Flights) pour des prix frais à la demande, 250 recherches/mois gratuites.
SERPAPI_KEY=
